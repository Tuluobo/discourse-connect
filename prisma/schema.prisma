generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?
  role      UserRole @default(USER)
  moderator Boolean  @default(false)
  groups    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications   Application[]
  codes          Code[]
  accessTokens   AccessToken[]
  authorizations Authorization[]

  @@index([role])
  @@map("users")
}

model Application {
  id          String  @id @default(cuid())
  name        String
  home        String
  logoUri     String?
  description String?

  // OAuth 2.0 核心字段
  clientId     String    @unique
  clientSecret String
  redirectUris String[] // 允许的重定向URI列表
  scopes       String[]  @default(["read"]) // 应用可请求的权限范围
  isActive     Boolean   @default(true)
  deletedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codes          Code[]
  accessTokens   AccessToken[]
  authorizations Authorization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 索引: clientId 已有 @unique，需要按用户查询应用和按状态过滤
  @@index([userId, isActive])
  @@index([isActive])
  @@map("applications")
}

model Code {
  id              String   @id @default(cuid())
  code            String   @unique
  redirectUri     String
  scopes          String[]
  challenge       String?
  challengeMethod String? // "S256" 或 "plain"
  expiresAt       DateTime // 过期时间标记着是否已消费

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // 需要：记录使用时间

  // 索引: code 已有 @unique，需要定期清理过期授权码，按应用查询授权码
  @@index([expiresAt])
  @@index([applicationId])
  @@map("codes")
}

model AccessToken {
  id    String @id @default(cuid())
  token String @unique

  // OAuth 2.0 核心字段
  createdAt DateTime @default(now())
  expiresAt DateTime
  scopes    String[]

  // 刷新令牌
  refreshToken          String?   @unique
  refreshTokenExpiresAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  authorizationId String?
  authorization   Authorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)

  // 索引: token 和 refreshToken 已有 @unique，需要定期清理过期令牌，按用户+应用查询令牌
  @@index([expiresAt])
  @@index([userId, applicationId])
  @@index([refreshTokenExpiresAt])
  @@map("access_tokens")
}

model Authorization {
  id String @id @default(cuid())

  // OAuth 2.0 核心字段
  scopes    String[]
  expiresAt DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt // 需要：记录授权更新时间
  deletedAt DateTime? // 需要：软删除支持撤销授权但保留历史

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  AccessToken AccessToken[]

  // 索引: userId+applicationId 已有 @unique，需要清理过期授权
  @@unique([userId, applicationId])
  @@index([expiresAt])
  @@map("authorizations")
}
